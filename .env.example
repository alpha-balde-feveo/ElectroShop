# ============================================================
# GayeTech Store — variables de PRODUCTION (docker compose)
# Copiez ce fichier :  cp .env.example .env  puis remplissez.
# Le fichier .env ne doit JAMAIS être commité (il est gitignoré).
# ============================================================

# Secret de signature des tokens admin (OBLIGATOIRE).
# Générez-le avec :  openssl rand -hex 32
JWT_SECRET=

# Compte administrateur créé au premier démarrage (OBLIGATOIRE)
ADMIN_EMAIL=admin@gayetechstore.sn
ADMIN_PASSWORD=

# Domaine(s) autorisés à appeler l'API (séparés par des virgules)
# Ex : https://gayetechstore.sn,https://www.gayetechstore.sn
CORS_ORIGIN=http://localhost

# Lien de paiement Wave Business (QR du retrait en boutique)
# Ex : https://pay.wave.com/m/M_XXXXXXXX/c/sn/
WAVE_LINK=

# Numéro WhatsApp de la boutique (international, sans +)
WHATSAPP_PHONE=221773672275
